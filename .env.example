# inspot-dashboard — environment contract (docs/architecture.md v1.1 §5.2)
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Database (Slice 0) ---
# PostgreSQL connection string.
# - Running Prisma CLI/migrations from the host against `docker compose`'s
#   `db` service: use localhost:3832 — docker-compose.yml maps host port
#   3832 -> container port 5432 (5432 is reserved for a locally installed
#   Postgres, not this compose stack).
# - Inside docker-compose (the `app` service itself): use `db:5432` — compose
#   service-to-service traffic uses the container's own port, unaffected by
#   the host port mapping above (see docker-compose.yml's `app.environment`).
DATABASE_URL="postgresql://postgres:postgres@localhost:3832/inspot?schema=public"

# --- Pagination (Slice 0, NFR-PERF-001) ---
# Default page size for all keyset-paginated list sections (Mail/Logs/Alerts/Messages).
LIST_PAGE_SIZE=50

# --- Calendar reminders ---
# REMINDER_SCHEDULER_TICK_MS=30000
# REMINDER_SCHEDULER_BATCH=100

# --- Webhook ingest limits (Slice 0 base contract; enforced starting Slice 4) ---
# Requests allowed per token per rate-limit window (ADR-006, AQ-4 resolved default).
WEBHOOK_RATE_LIMIT=120
# Rate-limit window size, in milliseconds.
WEBHOOK_RATE_WINDOW_MS=60000
# Max accepted webhook request body size, in bytes (default 64KB).
WEBHOOK_MAX_BODY_BYTES=65536

# --- Outgoing webhooks (durable delivery queue + scheduler) ---
# All optional with defaults shown below.
# Delivery scheduler tick interval, in milliseconds.
# WEBHOOK_SCHEDULER_TICK_MS=10000
# Per-attempt HTTP timeout for an outgoing delivery, in milliseconds.
# WEBHOOK_DELIVERY_TIMEOUT_MS=10000
# Max delivery attempts before a delivery is marked FAILED.
# WEBHOOK_DELIVERY_MAX_ATTEMPTS=5
# Lease duration while a delivery is in flight, in milliseconds (guards
# against double-send across restarts).
# WEBHOOK_DELIVERY_LEASE_MS=30000
# Max deliveries claimed per scheduler tick.
# WEBHOOK_DELIVERY_BATCH=50
# Consecutive failed deliveries before a webhook is disabled automatically.
# Reset on the next delivered attempt, and by re-enabling the webhook by hand.
# WEBHOOK_AUTO_DISABLE_AFTER=10
# NOTE: outgoing-webhook signing secrets are encrypted with the same
# CREDENTIAL_ENCRYPTION_KEY below — it must be set to configure webhooks.
# A DISCORD_EVENTS webhook additionally stores an Ed25519 private key in that
# same encrypted payload (specs/discord-webhook-compatibility.md §7).

# --- Operator auth (Slice 1, architecture §5.2, AQ-1 resolved) ---
# The single env-seeded operator's login username.
OPERATOR_USERNAME=
# Preferred: a pre-computed scrypt hash ("salt:hash"), used as-is — no
# plaintext secret in env. Provide exactly one of OPERATOR_PASSWORD_HASH /
# OPERATOR_PASSWORD; if both are set, OPERATOR_PASSWORD_HASH wins.
OPERATOR_PASSWORD_HASH=
# Convenience (dev only): plaintext password, hashed in memory at startup
# with a log warning recommending OPERATOR_PASSWORD_HASH instead.
# OPERATOR_PASSWORD=
# Local-login throttling (all optional; defaults shown).
# LOGIN_RATE_LIMIT_IP=30
# LOGIN_RATE_LIMIT_USERNAME=10
# LOGIN_RATE_WINDOW_MS=900000
# Trust forwarding headers only behind a configured trusted proxy.
# LOGIN_TRUST_PROXY=false

# --- Authentik SSO (third-party auth — absent = disabled, password login remains available) ---
# Base OIDC issuer URL from Authentik's application/provider screen,
# e.g. https://auth.example.com/application/o/inspoter/
# AUTHENTIK_ISSUER=
# OAuth2/OIDC client ID from the Authentik provider.
# AUTHENTIK_CLIENT_ID=
# OAuth2/OIDC client secret from the Authentik provider.
# AUTHENTIK_CLIENT_SECRET=
# Exact callback URL registered in Authentik's provider "Redirect URIs" —
# must match byte-for-byte (scheme/host/port/path) per the OIDC spec.
# AUTHENTIK_REDIRECT_URI=https://dashboard.example.com/api/auth/authentik/callback

# --- Mail client (multi-account IMAP/SMTP) ---
# All optional with defaults shown below.
# Mail sync scheduler tick interval, in milliseconds.
# MAIL_SYNC_TICK_MS=30000
# Messages fetched per folder on the first sync of an account.
# MAIL_INITIAL_SYNC_LIMIT=200
# Messages fetched per page after the initial sync (default 10).
# MAIL_SYNC_BATCH_SIZE=10
# Maximum raw message and decoded body sizes (default 5 MiB each).
# MAIL_MAX_MESSAGE_BYTES=5242880
# MAIL_MAX_BODY_BYTES=5242880
# Max attachment size served/downloaded, in bytes (default 25MB).
# MAIL_MAX_ATTACHMENT_BYTES=26214400
# Outgoing messages allowed per workspace per rate-limit window.
# MAIL_SEND_RATE_LIMIT=30
# Send rate-limit window size, in milliseconds (default 1 hour).
# MAIL_SEND_RATE_WINDOW_MS=3600000
# --- Workspace backup / restore (/settings/backup) ---
# All optional with defaults shown below.
# Max accepted import archive size, in bytes (default 512MB). Oversized
# uploads are rejected with HTTP 413.
# BACKUP_MAX_IMPORT_BYTES=536870912
# Timeout for the single interactive export/import transaction, in
# milliseconds (default 5 minutes).
# BACKUP_IMPORT_TX_TIMEOUT_MS=300000

# --- Contacts import (/contacts) ---
# All optional with defaults shown below.
# Max accepted contacts file size, in bytes (default 10MB). Oversized uploads
# are rejected with HTTP 413.
# CONTACTS_MAX_IMPORT_BYTES=10485760
# Max number of contacts a single file may hold (default 10000).
# CONTACTS_MAX_IMPORT_ROWS=10000
# Max stored contact photo size, in bytes (default 2MB). Larger photos in an
# imported vCard are dropped; a larger upload is rejected.
# CONTACTS_MAX_PHOTO_BYTES=2097152

# --- AI models (src/lib/llm) ---
# The endpoint and its API key are per-workspace credentials configured at
# /settings/providers, never env vars; only these transport and abuse bounds
# are deployment-wide. All optional, defaults shown.
# One model request waits this long and is never retried (default 60 s).
# LLM_REQUEST_TIMEOUT_MS=60000
# Fixed window per workspace, shared by every interactive AI feature
# (default 60/hour).
# LLM_CALL_RATE_LIMIT=60
# LLM_CALL_RATE_WINDOW_MS=3600000
# Separate window for agent runs, which spend one model call per step — a
# shared counter would let a few runs take the interactive features offline.
# LLM_AGENT_CALL_RATE_LIMIT=600
# LLM_AGENT_CALL_RATE_WINDOW_MS=3600000
# Separate embedding windows keep background Notes backfill from starving
# query embeddings used by an interactive chat turn.
# LLM_QUERY_EMBED_RATE_LIMIT=120
# LLM_INDEX_EMBED_RATE_LIMIT=600

# --- AI Assistant runs (src/lib/agents) ---
# Deployment-wide ceilings. Each agent carries its own limits and a run uses
# the smaller of the two, so one workspace cannot configure its way past what
# this deployment is willing to pay for. All optional, defaults shown.
# AGENT_RUN_MAX_STEPS_CEILING=24
# AGENT_RUN_MAX_TOKENS_CEILING=200000
# AGENT_RUN_MAX_TIMEOUT_SECONDS=1800
# What one tool may put into the model's context, and what a step row keeps
# for the run timeline.
# AGENT_TOOL_RESULT_MAX_CHARS=6000
# AGENT_STEP_PAYLOAD_MAX_CHARS=4000
# Logical chat history and automatically retrieved Notes context budgets.
# AGENT_CHAT_HISTORY_MAX_CHARS=24000
# AGENT_RAG_CONTEXT_MAX_CHARS=12000
# NOTE_INDEX_SCHEDULER_TICK_MS=5000
# NOTE_INDEX_JOB_BATCH=10
# The queue: lease length (a run holds it across N model round-trips), how many
# runs one tick claims, how many may run at once per workspace, and the tick.
# AGENT_RUN_LEASE_MS=120000
# AGENT_RUN_BATCH=5
# AGENT_MAX_CONCURRENT_RUNS_PER_WORKSPACE=2
# AGENT_SCHEDULER_TICK_MS=15000
# AGENT_SCHEDULE_BATCH=20
# Retention of the run history; steps go with a run through the cascade.
# AGENT_RUN_RETENTION_DAYS=30
# AGENT_RUN_RETENTION_TICK_MS=3600000

# --- Provider credentials ---
# Providers (Cloudflare, Hetzner DNS/Cloud, GoDaddy) are configured
# exclusively in the UI at /settings/providers — no env-var tokens.
# 32-byte hex key for encrypting provider credentials in DB; required to
# store and use provider credentials.
CREDENTIAL_ENCRYPTION_KEY=

# --- Provider listing cache (Domains / Hosting / Servers) ---
# All optional with defaults shown below. The sections render from a cached
# listing in the database; a background scheduler keeps it fresh so a page
# visit never fans out to the provider.
# How long a cached listing is served without refreshing it, in milliseconds
# (default 5 minutes).
# PROVIDER_SNAPSHOT_TTL_MS=300000
# Refresh scheduler tick interval, in milliseconds. Keep it below the TTL so
# a snapshot is never much older than TTL + one tick.
# PROVIDER_SNAPSHOT_TICK_MS=60000
# Automatic refresh can also be switched off per credential (at
# /settings/providers) and per section (at /settings/workspace). Manual
# refresh and the very first fetch always run.

# --- Server metric history (charts on a server's detail page) ---
# All optional with defaults shown below. Each metrics agent pushes once a
# minute, so one server writes roughly 1440 sample rows a day.
# How long history is kept, in days. 30 covers the deepest range the detail
# page offers; 0 disables history retention entirely (the sweep then deletes
# everything older than "now").
# SERVER_METRICS_RETENTION_DAYS=30
# Rows deleted per batch by the retention sweep.
# SERVER_METRICS_RETENTION_BATCH=5000
# Retention sweep interval, in milliseconds (default hourly).
# SERVER_METRICS_RETENTION_TICK_MS=3600000
