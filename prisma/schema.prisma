// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Origin: the 13-entity Slice-0 baseline was authored verbatim from
// docs/architecture.md v1.1 §2.3 in one initial migration (Decision P-1).
// P-1 revision (2026-07-18): approved feature slices legitimately extend this
// schema with reviewed, hand-authored follow-on migrations (workspaces, Q-13
// ownership, provider credentials, services, external identity, and the
// 20260718130000_mail_client_multi_account mail cluster). What remains
// prohibited is unreviewed ad-hoc incremental modeling — see
// docs/architecture.md §4.1 / docs/plan.md §4.1.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth (FR-AUTH-001) ---
enum WorkspaceRole {
  OWNER
  MEMBER
}

model Operator {
  id                 String             @id @default(cuid())
  username           String             @unique
  passwordHash       String? // scrypt hash; never returned (NFR-SEC-002). Null for Authentik-only accounts (no password set).
  email              String? // last-seen email claim from an external identity provider; display-only, never unique (an IdP email can change/be reused)
  defaultWorkspaceId String?
  defaultWorkspace   Workspace?         @relation("DefaultWorkspace", fields: [defaultWorkspaceId], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  sessions           Session[]
  memberships        WorkspaceMember[]
  externalIdentities ExternalIdentity[]
}

// --- Third-party auth (Authentik OIDC, first of possibly several IdPs) ---
enum ExternalIdentityProvider {
  AUTHENTIK
}

model ExternalIdentity {
  id          String                   @id @default(cuid())
  provider    ExternalIdentityProvider
  subject     String // OIDC `sub` claim — the actual linking key (never email)
  operatorId  String
  operator    Operator                 @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  email       String? // last-seen `email` claim; display/debug only, never used to match identity
  lastLoginAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([provider, subject])
  @@index([operatorId])
}

model Session {
  id                        String           @id // opaque random token (the cookie value)
  operatorId                String
  operator                  Operator         @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  activeWorkspaceId         String?
  activeWorkspaceOperatorId String?
  activeMembership          WorkspaceMember? @relation("ActiveWorkspaceMembership", fields: [activeWorkspaceId, activeWorkspaceOperatorId], references: [workspaceId, operatorId], onDelete: SetNull)
  expiresAt                 DateTime
  createdAt                 DateTime         @default(now())

  @@index([expiresAt])
}

model LoginRateLimitBucket {
  key             String   @id
  count           Int
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
}

// --- Workspaces ---
model Workspace {
  id                       String                 @id @default(cuid())
  name                     String
  slug                     String                 @unique
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  hiddenSections           String[]               @default([])
  // Section-wide kill switch for the background snapshot refresh, mirroring
  // hiddenSections above. Empty = every section refreshes automatically.
  autoRefreshDisabledKinds ProviderSnapshotKind[] @default([])

  members                 WorkspaceMember[]
  defaultForOperators     Operator[]                @relation("DefaultWorkspace")
  categories              Category[]
  bookmarks               Bookmark[]
  messageCategories       MessageCategory[]
  channels                Channel[]
  messages                Message[]
  mailAccounts            MailAccount[]
  mailFolders             MailFolder[]
  mailItems               MailItem[]
  mailLabels              MailLabel[]
  mailItemLabels          MailItemLabel[]
  mailFilterRules         MailFilterRule[]
  mailFilterConditions    MailFilterCondition[]
  mailFilterRuns          MailFilterRun[]
  mailFilterActionJobs    MailFilterActionJob[]
  contacts                Contact[]
  contactFields           ContactField[]
  contactAddresses        ContactAddress[]
  contactLabels           ContactLabel[]
  contactLabelAssignments ContactLabelAssignment[]
  logEntries              LogEntry[]
  alertCategories         AlertCategory[]
  alerts                  Alert[]
  webhookTokens           WebhookToken[]
  idempotencyKeys         IdempotencyKey[]
  providerBindings        ProviderResourceBinding[]
  credentials             ProviderCredential[]
  services                Service[]
  serviceChecks           ServiceCheck[]
  serviceLabels           ServiceLabel[]
  serviceLabelAssignments ServiceLabelAssignment[]
  outgoingWebhooks        OutgoingWebhook[]
  webhookDeliveries       WebhookDelivery[]
  localServers            LocalServer[]
  activities              Activity[]
  dashboards              Dashboard[]
  dashboardWidgets        DashboardWidget[]
  kanbanBoards            KanbanBoard[]
  kanbanColumns           KanbanColumn[]
  kanbanCards             KanbanCard[]
  kanbanLabels            KanbanLabel[]
  kanbanCardLabels        KanbanCardLabel[]
  kanbanChecklistItems    KanbanChecklistItem[]
  kanbanComments          KanbanComment[]
  noteFolders             NoteFolder[]
  notes                   Note[]
  noteLinks               NoteLink[]
  noteTags                NoteTag[]
  noteTagLinks            NoteTagLink[]
  noteAssets              NoteAsset[]
  agents                  Agent[]
  skills                  Skill[]
  agentSkills             AgentSkill[]
  agentSchedules          AgentSchedule[]
  agentRuns               AgentRun[]
  agentRunSteps           AgentRunStep[]
}

model WorkspaceMember {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  operatorId     String
  operator       Operator      @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  role           WorkspaceRole
  joinedAt       DateTime      @default(now())
  activeSessions Session[]     @relation("ActiveWorkspaceMembership")
  assignedCards  KanbanCard[]

  @@unique([workspaceId, operatorId])
  @@index([operatorId])
}

// --- Bookmarks (FR-BM-001..003, Slice 1) ---
model Category {
  id                        String     @id @default(cuid())
  workspaceId               String
  workspace                 Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                      String
  position                  Int        @default(0)
  bookmarks                 Bookmark[]
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt
  parentCategoryId          String?
  parentCategoryWorkspaceId String?
  parentCategory            Category?  @relation("CategoryParent", fields: [parentCategoryId, parentCategoryWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  childCategories           Category[] @relation("CategoryParent")

  @@unique([id, workspaceId])
  @@index([workspaceId, position, id])
  @@index([workspaceId, parentCategoryId, position, id])
}

model Bookmark {
  id                  String    @id @default(cuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categoryId          String
  categoryWorkspaceId String
  category            Category  @relation(fields: [categoryId, categoryWorkspaceId], references: [id, workspaceId], onDelete: Cascade) // AC-BM-004 cascade
  name                String
  url                 String
  icon                String? // reference value (A-2 / OQ-8): emoji | icon-name | URL
  color               String? // optional accent tone token: primary | accent | secondary (AC-BM-015..018)
  description         String?
  position            Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([workspaceId, categoryId, position, id]) // grouped display AC-BM-012
}

// --- Dashboards (widget boards, Homarr-style) ---
// A workspace holds any number of named dashboards; each dashboard holds
// widgets placed on a 12-column grid. `config` is the per-kind options object
// validated by WIDGET_CONFIG_SCHEMAS (src/lib/validation/dashboards.ts) — the
// column is Json rather than ten nullable columns because no two widget kinds
// share an option, and adding a kind must not require a migration.
enum DashboardWidgetKind {
  CLOCK
  WEATHER
  CALENDAR
  NOTE
  BOOKMARKS
  SERVICE_STATUS
  SERVER_METRICS
  MAIL
  MESSAGES
  ALERTS
  LOGS
  KANBAN
}

model Dashboard {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  position    Int               @default(0)
  // The dashboard the post-login redirect lands on. At most one per workspace:
  // raw partial unique index in the migration SQL (WHERE "isDefault") — not
  // expressible in the Prisma DSL, same as MailAccount's WEBHOOK uniqueness.
  isDefault   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  widgets     DashboardWidget[]

  @@unique([id, workspaceId])
  @@index([workspaceId, position, id])
}

model DashboardWidget {
  id                   String              @id @default(cuid())
  workspaceId          String
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dashboardId          String
  dashboardWorkspaceId String
  dashboard            Dashboard           @relation(fields: [dashboardId, dashboardWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  kind                 DashboardWidgetKind
  // Grid placement in cells: x/w on a 12-column axis, y/h on an unbounded row
  // axis. Non-overlap is a service-layer invariant (saveLayout), not a
  // constraint — a legal move rewrites several rows at once, so the check has
  // to see the whole proposed layout.
  x                    Int
  y                    Int
  w                    Int
  h                    Int
  config               Json                @default("{}")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId, dashboardId, y, x, id])
}

// --- Kanban (task boards) ---
// A workspace holds any number of named boards; each board owns its own
// ordered columns (the statuses) and the cards placed in them. Columns are
// per-board rather than workspace-wide because two boards rarely share a
// process — a release board's "QA" means nothing on a support board.

enum KanbanPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// The kinds of existing record a card may point at. Deliberately a soft link
// (type + id + denormalized label, no foreign key): a task outlives the alert
// or server that prompted it, and losing the target must degrade the card to
// an inert chip rather than delete the work item.
enum KanbanLinkType {
  SERVER
  DOMAIN
  SERVICE
  ALERT
  HOSTING_ACCOUNT
}

model KanbanBoard {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  position    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  columns     KanbanColumn[]
  cards       KanbanCard[]

  @@unique([id, workspaceId])
  @@index([workspaceId, position, id])
}

model KanbanColumn {
  id               String       @id @default(cuid())
  workspaceId      String
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  boardId          String
  boardWorkspaceId String
  board            KanbanBoard  @relation(fields: [boardId, boardWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  name             String
  // Preset name ("SLATE"…) or #RRGGBB, same encoding as ServiceLabel.color.
  color            String
  position         Int          @default(0)
  // Soft WIP limit: exceeding it highlights the column but never refuses a
  // drop — a hard block strands a card mid-drag with nowhere legal to go.
  wipLimit         Int?
  // Marks the terminal column. Moving a card in stamps completedAt; moving it
  // out clears it. Drives the kanban.card.completed webhook.
  isDone           Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  cards            KanbanCard[]

  @@unique([id, workspaceId])
  @@index([workspaceId, boardId, position, id])
}

model KanbanCard {
  id                  String                @id @default(cuid())
  workspaceId         String
  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  boardId             String
  boardWorkspaceId    String
  board               KanbanBoard           @relation(fields: [boardId, boardWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  columnId            String
  columnWorkspaceId   String
  column              KanbanColumn          @relation(fields: [columnId, columnWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  title               String
  // Sanitized HTML from the shared TipTap editor (see src/lib/kanban/sanitize.ts).
  description         String?
  position            Int                   @default(0)
  priority            KanbanPriority        @default(MEDIUM)
  dueDate             DateTime?
  // Assignee is a membership, not a bare operator: dropping someone from the
  // workspace must unassign their cards, which SetNull on the composite
  // WorkspaceMember key does for free.
  assigneeOperatorId  String?
  assigneeWorkspaceId String?
  assignee            WorkspaceMember?      @relation(fields: [assigneeWorkspaceId, assigneeOperatorId], references: [workspaceId, operatorId], onDelete: SetNull)
  linkedType          KanbanLinkType?
  linkedId            String?
  // Snapshot of the target's name at link time, so the chip stays readable
  // after the target is renamed or deleted.
  linkedLabel         String?
  completedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  labels              KanbanCardLabel[]
  checklistItems      KanbanChecklistItem[]
  comments            KanbanComment[]

  @@unique([id, workspaceId])
  @@index([workspaceId, boardId, columnId, position, id]) // board render
  @@index([workspaceId, dueDate]) // due/overdue widget
  @@index([assigneeWorkspaceId, assigneeOperatorId])
}

model KanbanLabel {
  id             String            @id @default(cuid())
  workspaceId    String
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  color          String // same encoding as ServiceLabel.color
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  cards          KanbanCardLabel[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, normalizedName])
}

model KanbanCardLabel {
  workspaceId      String
  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cardId           String
  cardWorkspaceId  String
  card             KanbanCard  @relation(fields: [cardId, cardWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  labelId          String
  labelWorkspaceId String
  label            KanbanLabel @relation(fields: [labelId, labelWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  appliedAt        DateTime    @default(now())

  @@unique([cardId, labelId])
  @@index([workspaceId, labelId, cardId])
}

model KanbanChecklistItem {
  id              String     @id @default(cuid())
  workspaceId     String
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cardId          String
  cardWorkspaceId String
  card            KanbanCard @relation(fields: [cardId, cardWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  text            String
  isDone          Boolean    @default(false)
  position        Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId, cardId, position, id])
}

model KanbanComment {
  id               String     @id @default(cuid())
  workspaceId      String
  workspace        Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cardId           String
  cardWorkspaceId  String
  card             KanbanCard @relation(fields: [cardId, cardWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  authorOperatorId String
  // Denormalized like Activity.operatorName: a comment must stay attributable
  // after the operator account is gone.
  authorName       String
  body             String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId, cardId, createdAt, id])
}

// --- Messages (FR-MSG-001..002) ---
model MessageCategory {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  channels       Channel[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([id, workspaceId])
  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, createdAt, id])
}

model Channel {
  id                         String          @id @default(cuid())
  workspaceId                String
  workspace                  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messageCategoryId          String
  messageCategoryWorkspaceId String
  messageCategory            MessageCategory @relation(fields: [messageCategoryId, messageCategoryWorkspaceId], references: [id, workspaceId], onDelete: Cascade) // AC-MSG-003
  name                       String
  normalizedName             String
  messages                   Message[]
  webhookTokens              WebhookToken[]
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  @@unique([id, workspaceId])
  @@unique([messageCategoryId, normalizedName])
  @@index([workspaceId, messageCategoryId, createdAt, id])
}

enum MessageOrigin {
  LEGACY
  OPERATOR
  WEBHOOK
  AGENT // written by an API token over /api/mcp or /api/v1/messages/**
}

model Message {
  id                 String        @id @default(cuid())
  workspaceId        String
  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelId          String
  channelWorkspaceId String
  channel            Channel       @relation(fields: [channelId, channelWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  content            String
  author             String? // source label from webhook payload
  origin             MessageOrigin @default(LEGACY)
  // Discord Execute Webhook compatibility (specs/discord-webhook-compatibility.md
  // §2.3). All four are optional: nothing but the Discord ingress route writes
  // them, and every pre-existing row keeps its defaults.
  embeds             Json? // array of Discord embed objects, at most 10
  avatarUrl          String? // payload `avatar_url`, shown next to the author
  tts                Boolean       @default(false) // stored, never spoken
  flags              Int           @default(0) // Discord message flags bitfield
  // Workspace-wide, not per-operator — same semantics as MailItem.isRead:
  // whoever opens the channel clears it for the whole workspace. Feeds the
  // topbar indicator and the per-channel badge in the channel sidebar.
  isRead             Boolean       @default(false)
  createdAt          DateTime      @default(now())

  @@index([workspaceId, channelId, createdAt, id]) // NFR-PERF-001 keyset pagination (id tiebreaker for equal createdAt) + AC-MSG-004 chronological
  @@index([workspaceId, createdAt, id]) // dashboard MESSAGES widget: latest messages across every channel
  @@index([workspaceId, isRead]) // topbar unread count
  @@index([workspaceId, channelId, isRead]) // per-channel unread badges + mark-channel-read
}

// --- Mail (FR-MAIL-001..002; multi-account mail client) ---
enum MailAccountKind {
  WEBHOOK
  IMAP
}

enum MailSecurity {
  SSL
  STARTTLS
}

enum MailSyncStatus {
  IDLE
  SYNCING
  ERROR
}

enum MailSpecialUse {
  INBOX
  SENT
  DRAFTS
  TRASH
  JUNK
  ARCHIVE
  OTHER
}

enum MailFilterRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum MailFilterMatchMode {
  ALL
  ANY
}

enum MailFilterConditionField {
  FROM_ADDRESS
  FROM_DOMAIN
  RECIPIENT
  SUBJECT
  BODY
  HAS_ATTACHMENT
}

enum MailFilterConditionOperator {
  EQUALS
  CONTAINS
  IS
}

enum MailFilterActionJobType {
  SET_READ
  MOVE_TO_FOLDER
}

enum MailFilterActionJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model MailAccount {
  id                      String                @id @default(cuid())
  workspaceId             String
  workspace               Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind                    MailAccountKind
  mode                    ProviderMode
  name                    String
  email                   String
  imapHost                String?
  imapPort                Int?
  imapSecurity            MailSecurity?
  smtpHost                String?
  smtpPort                Int?
  smtpSecurity            MailSecurity?
  username                String?
  encryptedData           String? // AES-256-GCM password payload (same scheme as ProviderCredential)
  iv                      String?
  authTag                 String?
  maskedHint              String?
  isValid                 Boolean?
  lastCheckedAt           DateTime?
  isActive                Boolean               @default(true)
  isDefault               Boolean               @default(false)
  syncStatus              MailSyncStatus        @default(IDLE)
  syncError               String?
  // Failure streak driving the ERROR flip (src/lib/services/mail-sync-status.ts):
  // a single dropped IMAP session must not raise a critical alert.
  consecutiveSyncFailures Int                   @default(0)
  lastSyncAt              DateTime?
  nextSyncAt              DateTime?
  syncLeaseExpiresAt      DateTime?
  syncIntervalSeconds     Int                   @default(300)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  folders                 MailFolder[]
  mailItems               MailItem[]
  filterRules             MailFilterRule[]
  filterActionJobs        MailFilterActionJob[]

  // At most one WEBHOOK account per workspace: raw partial unique index in the
  // migration SQL (WHERE "kind" = 'WEBHOOK') — not expressible in Prisma DSL.
  // At most one default account per workspace is likewise enforced by a raw
  // partial unique index (WHERE "isDefault").
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([isActive, nextSyncAt]) // scheduler due-query; intentionally NOT workspace-prefixed (cross-tenant sweep)
}

model MailFolder {
  id                 String           @id @default(cuid())
  workspaceId        String
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId          String
  accountWorkspaceId String
  account            MailAccount      @relation(fields: [accountId, accountWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  path               String
  name               String
  delimiter          String?
  specialUse         MailSpecialUse   @default(OTHER)
  position           Int              @default(0)
  uidValidity        BigInt?
  lastSeenUid        BigInt?
  lastSyncAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  mailItems          MailItem[]
  filterMoveRules    MailFilterRule[] @relation("MailFilterMoveTarget")

  @@unique([id, workspaceId])
  @@unique([accountId, path])
  @@index([workspaceId])
}

model MailItem {
  id                 String                @id @default(cuid())
  workspaceId        String
  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId          String
  accountWorkspaceId String
  account            MailAccount           @relation(fields: [accountId, accountWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  folderId           String
  folderWorkspaceId  String
  folder             MailFolder            @relation(fields: [folderId, folderWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  uid                BigInt? // IMAP UID; null for webhook-ingested items
  messageId          String?
  fromAddress        String
  fromName           String?
  toRecipients       Json?
  ccRecipients       Json?
  bccRecipients      Json?
  replyToAddress     String?
  subject            String
  bodyText           String
  bodyHtml           String?
  bodyTruncated      Boolean               @default(false)
  sourceSizeBytes    BigInt?
  draftReplyToId     String?
  draftForwardOfId   String?
  snippet            String?
  isRead             Boolean               @default(false)
  isAnswered         Boolean               @default(false)
  isFlagged          Boolean               @default(false)
  hasAttachments     Boolean               @default(false)
  receivedAt         DateTime              @default(now())
  createdAt          DateTime              @default(now())
  attachments        MailAttachment[]
  labels             MailItemLabel[]
  filterActionJobs   MailFilterActionJob[]

  @@unique([id, workspaceId])
  @@unique([folderId, uid]) // idempotent sync upsert; NULL uid (webhook items) never conflicts
  @@index([workspaceId])
  @@index([workspaceId, receivedAt, id]) // sort + keyset pagination (AC-MAIL-004/005)
  @@index([workspaceId, fromAddress]) // equality filter (AC-MAIL-003, NFR-PERF-002)
  @@index([workspaceId, accountId, folderId, receivedAt, id]) // per-folder list + keyset pagination
  @@index([workspaceId, accountId, folderId, isRead]) // unread filter + folder badge counts
  @@index([workspaceId, accountId, createdAt, id]) // historical filter-run keyset traversal
  @@index([workspaceId, accountId, draftReplyToId])
  @@index([workspaceId, accountId, draftForwardOfId])
}

model MailAttachment {
  id          String    @id @default(cuid())
  mailItemId  String
  mailItem    MailItem  @relation(fields: [mailItemId], references: [id], onDelete: Cascade)
  partId      String? // IMAP BODYSTRUCTURE part id; null for non-IMAP sources
  filename    String
  contentType String
  sizeBytes   Int
  contentId   String?
  isInline    Boolean   @default(false)
  content     Bytes? // lazily fetched from IMAP on first access, then cached
  fetchedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([mailItemId])
}

model MailLabel {
  id             String           @id @default(cuid())
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  color          String
  position       Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  mailItems      MailItemLabel[]
  filterRules    MailFilterRule[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, position, id])
}

model MailItemLabel {
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailItemId          String
  mailItemWorkspaceId String
  mailItem            MailItem  @relation(fields: [mailItemId, mailItemWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  labelId             String
  labelWorkspaceId    String
  label               MailLabel @relation(fields: [labelId, labelWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  appliedAt           DateTime  @default(now())

  @@unique([mailItemId, labelId])
  @@index([workspaceId, labelId, mailItemId])
}

model MailFilterRule {
  id                      String                @id @default(cuid())
  workspaceId             String
  workspace               Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId               String
  accountWorkspaceId      String
  account                 MailAccount           @relation(fields: [accountId, accountWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  labelId                 String
  labelWorkspaceId        String
  label                   MailLabel             @relation(fields: [labelId, labelWorkspaceId], references: [id, workspaceId], onDelete: Restrict)
  name                    String
  fromAddress             String?
  subjectContains         String?
  matchMode               MailFilterMatchMode   @default(ALL)
  setRead                 Boolean?
  moveToFolderId          String?
  moveToFolderWorkspaceId String?
  moveToFolder            MailFolder?           @relation("MailFilterMoveTarget", fields: [moveToFolderId, moveToFolderWorkspaceId], references: [id, workspaceId], onDelete: SetNull)
  isActive                Boolean               @default(true)
  position                Int                   @default(0)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  conditions              MailFilterCondition[]
  filterRuns              MailFilterRun[]

  @@unique([id, workspaceId])
  @@index([workspaceId, accountId, isActive, position, id])
}

model MailFilterCondition {
  id              String                      @id @default(cuid())
  workspaceId     String
  workspace       Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ruleId          String
  ruleWorkspaceId String
  rule            MailFilterRule              @relation(fields: [ruleId, ruleWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  field           MailFilterConditionField
  operator        MailFilterConditionOperator
  value           String
  isNegated       Boolean                     @default(false)
  position        Int                         @default(0)

  @@unique([id, workspaceId])
  @@unique([ruleId, position])
  @@index([workspaceId, ruleId, position, id])
}

model MailFilterRun {
  id                      String              @id @default(cuid())
  workspaceId             String
  workspace               Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ruleId                  String?
  ruleWorkspaceId         String?
  rule                    MailFilterRule?     @relation(fields: [ruleId, ruleWorkspaceId], references: [id, workspaceId], onDelete: SetNull)
  sourceRuleId            String
  snapshotAccountId       String
  snapshotLabelId         String
  snapshotFromAddress     String?
  snapshotSubjectContains String?
  snapshotMatchMode       MailFilterMatchMode @default(ALL)
  snapshotConditions      Json                @default("[]")
  snapshotSetRead         Boolean?
  snapshotMoveToFolderId  String?
  status                  MailFilterRunStatus @default(PENDING)
  cutoffCreatedAt         DateTime?
  cutoffId                String?
  cursorCreatedAt         DateTime?
  cursorId                String?
  processedCount          Int                 @default(0)
  matchedCount            Int                 @default(0)
  attempts                Int                 @default(0)
  lastError               String?
  leaseToken              String?
  leaseExpiresAt          DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId, sourceRuleId, createdAt, id])
  @@index([status, leaseExpiresAt, id])
}

model MailFilterActionJob {
  id                  String                    @id @default(cuid())
  workspaceId         String
  workspace           Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId           String
  accountWorkspaceId  String
  account             MailAccount               @relation(fields: [accountId, accountWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  mailItemId          String
  mailItemWorkspaceId String
  mailItem            MailItem                  @relation(fields: [mailItemId, mailItemWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  sourceRuleId        String
  sourceRunId         String?
  type                MailFilterActionJobType
  readValue           Boolean?
  targetFolderId      String?
  idempotencyKey      String                    @unique
  status              MailFilterActionJobStatus @default(PENDING)
  attempts            Int                       @default(0)
  maxAttempts         Int                       @default(3)
  nextAttemptAt       DateTime                  @default(now())
  leaseToken          String?
  leaseExpiresAt      DateTime?
  lastError           String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([id, workspaceId])
  @@index([status, nextAttemptAt, createdAt, id])
  @@index([accountId, status, createdAt, id])
  @@index([workspaceId, mailItemId, createdAt, id])
}

// --- Contacts (FR-CNT-001..006; Google-Contacts-style address book) ---
// A contact's single-valued identity lives on Contact; everything a person can
// have more than one of (emails, phones, sites, chat handles, dates, related
// people, custom pairs) lives in one polymorphic ContactField table. No two
// kinds need a column of their own, so six narrow tables would buy nothing and
// a new kind would cost a migration. Postal addresses are the exception — seven
// structural components that must stay addressable — and get their own table.
enum ContactFieldKind {
  EMAIL
  PHONE
  URL
  IM
  EVENT
  RELATION
  CUSTOM
}

model Contact {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Structured name (vCard N) plus the phonetic trio Google CSV carries.
  prefix         String?
  firstName      String?
  middleName     String?
  lastName       String?
  suffix         String?
  phoneticFirst  String?
  phoneticMiddle String?
  phoneticLast   String?
  nickname       String?
  fileAs         String?

  // Derived on every write by buildDisplayName/buildSortKey/buildSearchText
  // (src/lib/contacts/normalize.ts) — never set by hand. `sortKey` exists so
  // PostgreSQL can order the list without a locale-aware collation, and
  // `searchText` so one ILIKE covers names, organization, emails and phones.
  displayName String
  sortKey     String
  searchText  String

  organization String?
  jobTitle     String?
  department   String?
  // Text, not DateTime: vCard and Google both allow a year-less birthday
  // ("--04-12"), which no date type can hold. Format is ISO-8601 or "--MM-DD".
  birthday     String?
  notes        String?
  starred      Boolean @default(false)

  photo            Bytes?
  photoContentType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields    ContactField[]
  addresses ContactAddress[]
  labels    ContactLabelAssignment[]

  @@unique([id, workspaceId])
  @@index([workspaceId, sortKey, id])
  @@index([workspaceId, starred, sortKey, id])
}

model ContactField {
  id                 String           @id @default(cuid())
  workspaceId        String
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId          String
  contactWorkspaceId String
  contact            Contact          @relation(fields: [contactId, contactWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  kind               ContactFieldKind
  // Free-form: the well-known vCard types (home/work/mobile/…) plus whatever
  // label the source file carried, so a round-trip never loses one.
  label              String?
  value              String
  // Lowercased email / digits-only phone. Powers duplicate detection and the
  // mail compose autocomplete; null for kinds with no meaningful normal form.
  normalizedValue    String?
  isPrimary          Boolean          @default(false)
  position           Int              @default(0)
  createdAt          DateTime         @default(now())

  @@unique([id, workspaceId])
  @@index([workspaceId, contactId, kind, position])
  @@index([workspaceId, kind, normalizedValue])
}

model ContactAddress {
  id                 String    @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId          String
  contactWorkspaceId String
  contact            Contact   @relation(fields: [contactId, contactWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  label              String?
  poBox              String?
  extended           String?
  street             String?
  city               String?
  region             String?
  postalCode         String?
  country            String?
  // Source's own single-line rendering (Google CSV "Address 1 - Formatted",
  // vCard LABEL). Kept verbatim so an import that carried one can give it back.
  formatted          String?
  position           Int       @default(0)
  createdAt          DateTime  @default(now())

  @@unique([id, workspaceId])
  @@index([workspaceId, contactId, position])
}

model ContactLabel {
  id             String                   @id @default(cuid())
  workspaceId    String
  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  color          String
  position       Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  contacts       ContactLabelAssignment[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, position, id])
}

model ContactLabelAssignment {
  workspaceId        String
  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId          String
  contactWorkspaceId String
  contact            Contact      @relation(fields: [contactId, contactWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  labelId            String
  labelWorkspaceId   String
  label              ContactLabel @relation(fields: [labelId, labelWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  appliedAt          DateTime     @default(now())

  @@unique([contactId, labelId])
  @@index([workspaceId, labelId, contactId])
}

// --- Activity (user action journal) ---
model Activity {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  operatorId   String
  operatorName String
  action       String
  entityType   String
  entityId     String?
  entityLabel  String?
  details      String?
  timestamp    DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([workspaceId, timestamp, id])
  @@index([workspaceId, action, timestamp, id])
  @@index([workspaceId, entityType, timestamp, id])
  @@index([workspaceId, operatorId, timestamp, id])
}

// --- Logs (FR-LOG-001..002) ---
model LogEntry {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  level       String // e.g. info|warn|error (validated by zod, stored as string)
  source      String
  message     String
  details     String?
  timestamp   DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([workspaceId, timestamp, id]) // sort + keyset pagination (AC-LOG-003/004)
  @@index([workspaceId, level, timestamp, id]) // equality filter (AC-LOG-002)
  @@index([workspaceId, source, timestamp, id]) // equality filter (AC-LOG-002)
}

// --- Alerts (FR-ALR-001..003) ---
// Who decided an alert's category. Recorded so an automatic classifier can
// never silently overwrite an operator's decision, and so the UI can tell a
// human's choice from a guess.
enum AlertCategorySource {
  WEBHOOK // came in the ingest payload
  MANUAL // set by an operator
  RULE // deterministic rule (no such engine yet)
  MODEL // proposed by a model (no such caller yet)
}

model AlertCategory {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  // Case-folded name, same encoding as MailLabel/ServiceLabel. Third-party
  // senders spell one category three ways ("availability", "Availability",
  // "AVAILABILITY "), and upsert-by-name alone would create three categories.
  normalizedName String
  // Free-form hint about what belongs here — the only context a classifier
  // gets beyond the bare name.
  description    String?
  // Set only on the categories Inspoter creates for its own alerts
  // (SYSTEM_ALERT_CATEGORIES in src/lib/services/alert-catalog.ts): `name`
  // holds the English base wording, and the UI renders the active locale's
  // translation instead. Cleared the moment an operator renames the category —
  // their own wording outranks the built-in translation.
  systemKey      String?
  alerts         Alert[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([id, workspaceId])
  @@unique([workspaceId, normalizedName])
}

model Alert {
  id                       String               @id @default(cuid())
  workspaceId              String
  workspace                Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  alertCategoryId          String?
  alertCategoryWorkspaceId String?
  alertCategory            AlertCategory?       @relation(fields: [alertCategoryId, alertCategoryWorkspaceId], references: [id, workspaceId], onDelete: SetNull) // D-12: reassign to uncategorized, no orphan (AC-ALR-002)
  // Null exactly when alertCategoryId is null (including after AC-ALR-002
  // category deletion, which reassigns to uncategorized).
  categorySource           AlertCategorySource?
  // Only ever written together with categorySource = MODEL.
  categoryConfidence       Float?
  severity                 String
  source                   String
  // Always the English base rendering, so search, webhook payloads, backups
  // and the MCP tools all see one stable text regardless of who is looking.
  message                  String
  // Set only on alerts Inspoter raises itself: the `alerts.system.*` key and
  // its ICU arguments behind `message`, which lets the UI re-render the same
  // alert in the active locale. Null for webhook-ingested alerts, whose text
  // belongs to the sender and cannot be translated.
  messageKey               String?
  messageParams            Json?
  // Workspace-wide, not per-operator — same semantics as MailItem.isRead.
  // Opening the Alerts section clears every unread row at once.
  isRead                   Boolean              @default(false)
  timestamp                DateTime             @default(now())
  createdAt                DateTime             @default(now())

  @@index([workspaceId, isRead]) // topbar unread count + mark-all-read
  @@index([workspaceId, timestamp, id]) // sort + keyset pagination (AC-ALR-005/006)
  @@index([workspaceId, alertCategoryId, timestamp, id]) // filter by category (AC-ALR-004)
  @@index([workspaceId, severity, timestamp, id]) // filter by severity (AC-ALR-004)
  @@index([workspaceId, source, timestamp, id]) // filter by source (AC-ALR-004)
}

// --- Services (uptime monitoring) ---
enum MonitorType {
  HTTP
  TCP
  PING
}

enum ServiceStatus {
  PENDING
  UP
  DOWN
}

model Service {
  id                  String                   @id @default(cuid())
  workspaceId         String
  workspace           Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  monitorType         MonitorType
  url                 String? // HTTP(S)
  host                String? // TCP, PING
  port                Int? // TCP required; PING optional (default 80 at check time)
  expectedStatusCodes String? // HTTP only, e.g. "200-299"
  intervalSeconds     Int                      @default(60)
  timeoutMs           Int                      @default(5000)
  retries             Int                      @default(1) // consecutive failures before flipping to DOWN
  isActive            Boolean                  @default(true)
  currentStatus       ServiceStatus            @default(PENDING)
  consecutiveFailures Int                      @default(0)
  lastCheckedAt       DateTime?
  lastResponseTimeMs  Int?
  lastMessage         String?
  nextCheckAt         DateTime                 @default(now())
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  checks              ServiceCheck[]
  labels              ServiceLabelAssignment[]

  @@unique([id, workspaceId])
  @@index([workspaceId, name])
  @@index([isActive, nextCheckAt]) // scheduler due-query; intentionally NOT workspace-prefixed (cross-tenant sweep)
}

// Workspace-scoped service labels, modeled on MailLabel/MailItemLabel above.
// Two deliberate simplifications versus the mail cluster: no `position`
// column (labels are ordered by normalizedName, there is no reorder UI) and
// no restrictive foreign key (nothing references a service label the way
// MailFilterRule references a MailLabel, so deletion just cascades).
model ServiceLabel {
  id             String                   @id @default(cuid())
  workspaceId    String
  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  color          String // preset name ("SLATE"…) or #RRGGBB, same encoding as MailLabel.color
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  services       ServiceLabelAssignment[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, normalizedName])
}

model ServiceLabelAssignment {
  workspaceId        String
  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  serviceId          String
  serviceWorkspaceId String
  service            Service      @relation(fields: [serviceId, serviceWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  labelId            String
  labelWorkspaceId   String
  label              ServiceLabel @relation(fields: [labelId, labelWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  appliedAt          DateTime     @default(now())

  @@unique([serviceId, labelId])
  @@index([workspaceId, labelId, serviceId])
}

model ServiceCheck {
  id                 String        @id @default(cuid())
  workspaceId        String
  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  serviceId          String
  serviceWorkspaceId String
  service            Service       @relation(fields: [serviceId, serviceWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  status             ServiceStatus // UP | DOWN, never PENDING
  responseTimeMs     Int?
  message            String?
  checkedAt          DateTime      @default(now())
  createdAt          DateTime      @default(now())

  @@index([workspaceId, serviceId, checkedAt, id]) // keyset pagination, mirrors LogEntry/Alert style
}

// --- Webhook (FR-WH-001..002) ---
model WebhookToken {
  id                 String           @id @default(cuid())
  workspaceId        String
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelId          String?
  channelWorkspaceId String?
  channel            Channel?         @relation(fields: [channelId, channelWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  name               String
  tokenHash          String           @unique // sha256 of secret; raw secret shown once (AC-WH-008), never stored
  tokenPrefix        String // first chars, for UI identification only
  createdAt          DateTime         @default(now())
  revokedAt          DateTime? // AC-WH-009 revoke -> 401
  lastUsedAt         DateTime?
  // MCP permissions (src/lib/mcp/scopes.ts). Empty = ingest-only token: the
  // webhook and server-metrics pipelines never look at this column, so every
  // pre-existing token keeps working and gains no read access to the
  // workspace.
  scopes             String[]         @default([])
  idempotencyKeys    IdempotencyKey[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, channelId, createdAt, id])
}

model IdempotencyKey {
  id               String       @id @default(cuid())
  workspaceId      String
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tokenId          String
  tokenWorkspaceId String
  token            WebhookToken @relation(fields: [tokenId, tokenWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  key              String // client-supplied Idempotency-Key
  targetType       String // mail | message | log | alert
  targetId         String // id of the created entry, returned on replay
  createdAt        DateTime     @default(now())

  @@unique([tokenId, key]) // AC-WH-004 per-token scoping; DB uniqueness = race-safe dedup
  @@index([workspaceId, tokenId, key])
}

// --- Outgoing webhooks (FR-OWH-001..003) ---
// Mirrors the four inbound webhook types (log|alert|mail|message from
// src/lib/webhooks/dispatch.ts) plus SERVICE_STATUS for monitor flips.
enum OutgoingWebhookEvent {
  AGENT_RUN_COMPLETED
  ALERT_CREATED
  SERVICE_STATUS
  MESSAGE_CREATED
  LOG_CREATED
  MAIL_RECEIVED
  KANBAN_CARD_CREATED
  KANBAN_CARD_MOVED
  KANBAN_CARD_COMPLETED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERING
  DELIVERED
  FAILED
}

// Wire format of an outgoing delivery (specs/discord-webhook-compatibility.md
// §6-§7). INSPOT is the original envelope + HMAC-SHA256 signature and stays the
// default, so existing subscriptions are untouched.
enum OutgoingWebhookFormat {
  INSPOT
  DISCORD_EXECUTE
  DISCORD_EVENTS
  TELEGRAM_BOT
}

// A subscription/endpoint an operator configures. Signing secret is stored
// encrypted (AES-256-GCM, same scheme as ProviderCredential/MailAccount) and
// shown once at creation; secretPrefix is display-only.
model OutgoingWebhook {
  id                  String                 @id @default(cuid())
  workspaceId         String
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                String
  url                 String
  events              OutgoingWebhookEvent[]
  isActive            Boolean                @default(true)
  encryptedData       String // AES-256-GCM ciphertext of the signing secret
  iv                  String
  authTag             String
  secretPrefix        String // first chars, for UI identification only
  format              OutgoingWebhookFormat  @default(INSPOT)
  // Ed25519 public key (64 hex chars), DISCORD_EVENTS only. The matching
  // private key rides inside the encrypted payload above as a
  // WEBHOOK_ED25519_KEY member; the public half is shown to the operator so the
  // receiver can verify signatures.
  publicKey           String?
  // TELEGRAM_BOT only: the chat the report goes to. Plaintext on purpose —
  // addressing, not a secret, and the settings list has to show where a
  // subscription points. The bot token rides in the encrypted payload above
  // as a WEBHOOK_TELEGRAM_BOT member.
  targetChatId        String?
  // Consecutive terminal failures; reset on every delivered attempt. Reaching
  // WEBHOOK_AUTO_DISABLE_AFTER flips isActive to false (Discord parity).
  consecutiveFailures Int                    @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deliveries          WebhookDelivery[]

  @@unique([id, workspaceId]) // composite FK target (project convention)
  @@index([workspaceId, createdAt, id])
  @@index([workspaceId, isActive]) // fan-out lookup: active subscriptions of a workspace
}

// Durable delivery queue + history. One row per (event, subscription) fan-out.
model WebhookDelivery {
  id                 String                @id @default(cuid())
  workspaceId        String
  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  webhookId          String
  webhookWorkspaceId String
  webhook            OutgoingWebhook       @relation(fields: [webhookId, webhookWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  event              OutgoingWebhookEvent
  payload            Json
  status             WebhookDeliveryStatus @default(PENDING)
  attempts           Int                   @default(0)
  maxAttempts        Int                   @default(5)
  nextAttemptAt      DateTime              @default(now())
  leaseExpiresAt     DateTime? // guards against double-send across restarts
  lastError          String?
  lastStatusCode     Int?
  lastAttemptAt      DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([workspaceId, webhookId, createdAt, id]) // history + keyset pagination
  @@index([status, nextAttemptAt]) // scheduler due-query; intentionally NOT workspace-prefixed (cross-tenant sweep)
  @@index([status, createdAt]) // retention prune scan; also cross-tenant, mirrors the sweep above
}

// --- Provider resource bindings (Q-13) ---
enum ProviderResourceType {
  DOMAIN
  SERVER
}

enum ProviderMode {
  MOCK
  REAL
}

enum ProviderOperationState {
  IDLE
  RUNNING
  RECONCILE_REQUIRED
}

model ProviderResourceBinding {
  id                      String                 @id @default(cuid())
  workspaceId             String
  workspace               Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  provider                String
  accountKey              String
  resourceType            ProviderResourceType
  mode                    ProviderMode
  remoteId                String
  displayName             String
  operationState          ProviderOperationState @default(IDLE)
  operationId             String?                @unique
  operationKind           String?
  operationIntent         Json?
  operationStartedAt      DateTime?
  operationLeaseExpiresAt DateTime?
  lastReconciledAt        DateTime?
  version                 Int                    @default(1)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@unique([id, workspaceId])
  @@unique([provider, accountKey, resourceType, mode, remoteId])
  @@index([workspaceId, resourceType, provider, mode])
  @@index([operationState, operationLeaseExpiresAt])
}

// --- Provider credentials (encrypted, workspace-scoped) ---
enum ProviderType {
  CLOUDFLARE_DNS
  HETZNER_DNS
  HETZNER_CLOUD
  GODADDY_DNS
  HOSTINGER
  CPANEL_WHM
  CPANEL_UAPI
  // OpenAI-compatible chat/embeddings endpoint (Ollama, vLLM, LM Studio,
  // OpenRouter, DeepSeek, OpenAI itself) — see src/lib/llm.
  OPENAI_COMPATIBLE
  // Anthropic-compatible messages endpoint (z.ai/GLM, Anthropic itself) —
  // see src/lib/llm/anthropic.ts. Chat only: the Messages API has no
  // embeddings endpoint, so embed() reports "unsupported".
  ANTHROPIC_COMPATIBLE
}

model ProviderCredential {
  id                 String       @id @default(cuid())
  workspaceId        String
  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider           ProviderType
  label              String
  encryptedData      String
  iv                 String
  authTag            String
  maskedHint         String
  allowInsecure      Boolean      @default(false)
  isValid            Boolean?
  lastCheckedAt      DateTime?
  lastSyncError      String?
  lastSyncErrorAt    DateTime?
  lastSyncOkAt       DateTime?
  // Per-credential kill switch for the background snapshot refresh
  // (provider-snapshot-scheduler.ts). Manual refresh and the very first
  // fetch ignore it — turning it off freezes the data, it never empties
  // the section.
  autoRefreshEnabled Boolean      @default(true)
  // Active credential of its category for the workspace (only src/lib/llm
  // reads it today). "One default per category" is held by
  // credentialsService.setDefaultCredential, not by the database: the
  // category lives in src/lib/providers/registry.ts, and a column would be
  // a second source of truth. No flag anywhere means the previous
  // oldest-wins behavior.
  isDefault          Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  localServers LocalServer[]
  snapshots    ProviderSnapshot[]

  @@unique([id, workspaceId])
  @@index([workspaceId, provider])
  @@index([workspaceId])
}

// --- Provider listing cache (ADR-004 amendment) ---
// A non-authoritative read cache of one credential's listing, so a page
// render costs a constant number of SQL queries instead of an N+1 fan-out
// to the provider on every visit. The provider stays the source of truth:
// every mutation goes straight to its API and never reads or writes this
// table as data. Dropping the whole table is safe — it rebuilds itself,
// which is also why it is excluded from backup/restore (same as
// ServerMetricSnapshot).
enum ProviderSnapshotKind {
  DNS_ZONES
  HOSTING_ACCOUNTS
  SERVERS
}

model ProviderSnapshot {
  workspaceId  String
  credentialId String
  kind         ProviderSnapshotKind
  // The finished per-credential group DTO, so reading is a parse and not a
  // reassembly: DomainsByProvider / AccountsByProvider / ServersByProvider.
  payload      Json
  // Provider error as of this snapshot; payload then holds an empty listing.
  error        String?
  fetchedAt    DateTime             @default(now())

  credential ProviderCredential @relation(fields: [credentialId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([credentialId, kind])
  @@index([workspaceId, kind])
  @@index([kind, fetchedAt]) // scheduler due-scan; cross-tenant by design
}

// --- Server metrics agent (FR-SRV-003, specs/metrics-script.md §8) ---
enum LocalServerOrigin {
  PROVIDER
  AGENT
}

enum ServerAddressFamily {
  IPV4
  IPV6
}

enum ServerAddressScope {
  GLOBAL
  PRIVATE
  LINK_LOCAL
  LOOPBACK
  RESERVED
  OTHER
}

enum ServerAddressSource {
  PROVIDER
  AGENT
}

model LocalServer {
  id                            String                @id @default(cuid())
  workspaceId                   String
  workspace                     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  origin                        LocalServerOrigin
  displayName                   String
  hostname                      String?
  providerCredentialId          String?
  providerCredentialWorkspaceId String?
  providerCredential            ProviderCredential?   @relation(fields: [providerCredentialId, providerCredentialWorkspaceId], references: [id, workspaceId], onDelete: Restrict)
  providerRemoteId              String?
  providerLastSeenAt            DateTime?
  providerMissingAt             DateTime?
  metricsAlertState             String?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  addresses                     LocalServerAddress[]
  metricSnapshot                ServerMetricSnapshot?
  metricSamples                 ServerMetricSample[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, providerCredentialId, providerRemoteId])
  @@index([workspaceId, origin, createdAt, id])
  @@index([workspaceId, providerMissingAt])
}

model LocalServerAddress {
  id                String              @id @default(cuid())
  workspaceId       String
  localServerId     String
  localServer       LocalServer         @relation(fields: [localServerId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  address           String
  family            ServerAddressFamily
  scope             ServerAddressScope
  source            ServerAddressSource
  matchKey          String?
  isCurrent         Boolean             @default(true)
  isEnrollmentClaim Boolean             @default(false)
  retiredAt         DateTime?
  claimConflictAt   DateTime?
  firstSeenAt       DateTime            @default(now())
  lastSeenAt        DateTime            @default(now())

  @@unique([workspaceId, localServerId, address, source])
  @@index([workspaceId, address])
  @@index([workspaceId, localServerId])
}

model ServerMetricSnapshot {
  localServerId            String      @id
  workspaceId              String
  localServer              LocalServer @relation(fields: [localServerId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  schemaVersion            Int
  agentVersion             String
  hostname                 String
  capturedAt               DateTime
  receivedAt               DateTime    @default(now())
  cpuUsagePercent          Float
  load1                    Float
  load5                    Float
  load15                   Float
  memoryTotalBytes         BigInt
  memoryAvailableBytes     BigInt
  swapTotalBytes           BigInt
  swapFreeBytes            BigInt
  filesystemTotalBytes     BigInt
  filesystemAvailableBytes BigInt
  uptimeSeconds            BigInt

  @@unique([localServerId, workspaceId])
  @@index([workspaceId, receivedAt])
}

// Time series behind the server detail page's charts. ServerMetricSnapshot
// above keeps exactly one row per server (the current state the cards read);
// this table keeps every accepted push, so "what did CPU do over the last two
// days" is answerable at all. Written only when a payload passes the
// snapshot's out-of-order guard, and pruned by
// server-metrics-retention-scheduler.ts.
//
// The unique key is (localServerId, capturedAt): a redelivered payload carries
// the same capture instant, and the ingest inserts with ON CONFLICT DO NOTHING
// so a retry can never abort the surrounding transaction.
model ServerMetricSample {
  id                       String      @id @default(cuid())
  localServerId            String
  workspaceId              String
  localServer              LocalServer @relation(fields: [localServerId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  capturedAt               DateTime
  cpuUsagePercent          Float
  load1                    Float
  load5                    Float
  load15                   Float
  memoryTotalBytes         BigInt
  memoryAvailableBytes     BigInt
  swapTotalBytes           BigInt
  swapFreeBytes            BigInt
  filesystemTotalBytes     BigInt
  filesystemAvailableBytes BigInt
  uptimeSeconds            BigInt

  @@unique([localServerId, capturedAt])
  @@index([workspaceId, localServerId, capturedAt])
  @@index([capturedAt])
}

// --- Notes (Obsidian-style note vault) ---
// A workspace holds one vault: an arbitrarily nested folder tree of
// markdown notes, wiki-links between them, managed color tags, and image
// attachments. Notes is a distinct feature from the single-note "sticky"
// dashboard widget (DashboardWidgetKind.NOTE) — see the NOTES enum value
// added in the migration for that name collision.
model NoteFolder {
  id                      String       @id @default(cuid())
  workspaceId             String
  workspace               Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                    String
  normalizedName          String
  parentFolderId          String?
  parentFolderWorkspaceId String?
  parentFolder            NoteFolder?  @relation("NoteFolderParent", fields: [parentFolderId, parentFolderWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  childFolders            NoteFolder[] @relation("NoteFolderParent")
  // Materialized depth from the vault root. This is the cheap half of cycle
  // protection — it only rejects depth overflow and immediate
  // self-parenting via the migration's CHECK constraints. A longer cycle
  // (A -> B -> C -> A) requires comparing rows to each other and is caught
  // by a recursive CTE in src/lib/services/note-folders.ts before a move is
  // committed.
  depth                   Int          @default(0)
  position                Int          @default(0)
  notes                   Note[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  // Sibling name uniqueness (both within a parent and among root folders) is
  // enforced by two partial unique indexes in the migration SQL — Prisma's
  // @@unique cannot express a WHERE clause.

  @@unique([id, workspaceId])
  @@index([workspaceId, parentFolderId, position, id])
}

model Note {
  id                String                   @id @default(cuid())
  workspaceId       String
  workspace         Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folderId          String?
  folderWorkspaceId String?
  folder            NoteFolder?              @relation(fields: [folderId, folderWorkspaceId], references: [id, workspaceId], onDelete: Cascade) // null = vault root
  title             String
  normalizedTitle   String
  // Source-of-truth CommonMark text — NEVER HTML. Rendered only through the
  // ProseMirror schema (src/components/notes/note-editor*), so no
  // sanitize-html pass is needed here, unlike KanbanCard.description.
  content           String                   @default("")
  // Plain-text lead of the body, for list rows.
  excerpt           String                   @default("")
  isPinned          Boolean                  @default(false)
  // Optimistic concurrency counter. Deliberately NOT updatedAt: re-indexing
  // links after someone else's rename also touches updatedAt, which would
  // look like a conflict to whoever is mid-typing.
  version           Int                      @default(1)
  /// Generated STORED tsvector column, created and indexed with GIN in raw
  /// SQL — Prisma has no tsvector type. The generated client never reads or
  /// writes this field; all full-text search queries go through $queryRaw
  /// in src/lib/services/notes.ts.
  searchVector      Unsupported("tsvector")?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  outgoingLinks NoteLink[]    @relation("NoteLinkSource")
  incomingLinks NoteLink[]    @relation("NoteLinkTarget")
  tags          NoteTagLink[]
  assets        NoteAsset[]

  @@unique([id, workspaceId])
  // Global-in-workspace title uniqueness is what makes [[Note]] resolvable
  // without a disambiguation policy.
  @@unique([workspaceId, normalizedTitle])
  @@index([workspaceId, folderId, normalizedTitle])
  @@index([workspaceId, updatedAt, id])
}

model NoteLink {
  id                    String    @id @default(cuid())
  workspaceId           String
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceNoteId          String
  sourceNoteWorkspaceId String
  sourceNote            Note      @relation("NoteLinkSource", fields: [sourceNoteId, sourceNoteWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  targetNoteId          String?
  targetNoteWorkspaceId String?
  // SetNull, not Cascade: deleting a note must turn links to it into
  // visible unresolved links, not erase the fact that it was referenced.
  targetNote            Note?     @relation("NoteLinkTarget", fields: [targetNoteId, targetNoteWorkspaceId], references: [id, workspaceId], onDelete: SetNull)
  // Normalized target title exactly as written inside [[ ]].
  targetTitle           String
  // The |alias| half of [[Note|alias]].
  displayText           String?
  occurrences           Int       @default(1)
  createdAt             DateTime  @default(now())

  @@unique([sourceNoteId, targetTitle])
  @@index([workspaceId, targetNoteId])
  @@index([workspaceId, targetTitle])
}

model NoteTag {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  color          String // same encoding as KanbanLabel.color
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  notes          NoteTagLink[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, normalizedName])
}

model NoteTagLink {
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  noteId          String
  noteWorkspaceId String
  note            Note      @relation(fields: [noteId, noteWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  tagId           String
  tagWorkspaceId  String
  tag             NoteTag   @relation(fields: [tagId, tagWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  appliedAt       DateTime  @default(now())

  @@unique([noteId, tagId])
  @@index([workspaceId, tagId, noteId])
}

model NoteAsset {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  noteId          String
  noteWorkspaceId String
  note            Note      @relation(fields: [noteId, noteWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  filename        String
  contentType     String
  sizeBytes       Int
  content         Bytes
  createdAt       DateTime  @default(now())

  @@unique([id, workspaceId])
  @@index([workspaceId, noteId, createdAt])
}

// --- AI Assistant (agents, skills, scheduled runs) ---
//
// An Agent is an operator-authored system prompt plus a subset of the MCP
// scopes (src/lib/mcp/scopes.ts). The runtime hands the model exactly the
// tools those scopes select, so an out-of-scope tool is structurally absent
// rather than blocked at call time.
//
// A Skill is a reusable prompt fragment with an optional tool narrowing. It
// never grants privilege: the effective toolset is the agent's scopes, then
// intersected with the union of the attached skills' toolNames when any of
// them declares one.

enum AgentRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentRunTrigger {
  MANUAL
  SCHEDULE
}

enum AgentRunStepKind {
  MODEL_CALL
  TOOL_CALL
}

enum AgentScheduleKind {
  INTERVAL
  DAILY
  WEEKLY
}

model Agent {
  id                 String    @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  normalizedName     String
  description        String?
  // The operator-authored half of the system prompt. Trusted input: it comes
  // from a workspace member, unlike anything a tool returns.
  instructions       String
  // Subset of MCP_SCOPES, stored as plain strings like WebhookToken.scopes so
  // an unknown value from another deployment is dropped rather than trusted.
  scopes             String[]  @default([])
  // Per-agent ceilings, each clamped again by an AGENT_* env ceiling at run
  // time so one workspace cannot configure its way out of the envelope.
  maxSteps           Int       @default(8)
  maxTokens          Int       @default(20000)
  timeoutSeconds     Int       @default(300)
  // Emit AGENT_RUN_COMPLETED to the outgoing webhooks when a run finishes.
  reportOnCompletion Boolean   @default(false)
  isActive           Boolean   @default(true)
  lastRunAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  skills    AgentSkill[]
  schedules AgentSchedule[]
  runs      AgentRun[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, normalizedName])
}

model Skill {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  // One line, always injected as the skill index even when the body is cut by
  // the prompt budget — the model still needs to know the skill exists.
  description    String
  // Markdown body appended to the system prompt in AgentSkill.position order.
  instructions   String
  // Optional narrowing of the agent's toolset. Empty means "no opinion".
  toolNames      String[]  @default([])
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  agents AgentSkill[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, normalizedName])
}

model AgentSkill {
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId          String
  agentWorkspaceId String
  agent            Agent     @relation(fields: [agentId, agentWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  skillId          String
  skillWorkspaceId String
  skill            Skill     @relation(fields: [skillId, skillWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  // Injection order of the skill bodies; ties broken by skillId.
  position         Int
  attachedAt       DateTime  @default(now())

  @@unique([agentId, skillId])
  @@index([workspaceId, agentId, position, skillId])
}

model AgentSchedule {
  id               String            @id @default(cuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId          String
  agentWorkspaceId String
  agent            Agent             @relation(fields: [agentId, agentWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  name             String
  kind             AgentScheduleKind
  // INTERVAL only.
  intervalSeconds  Int?
  // DAILY and WEEKLY: minutes since midnight in `timeZone`.
  minuteOfDay      Int?
  // WEEKLY only: 0 = Sunday, matching Date.getUTCDay().
  daysOfWeek       Int[]             @default([])
  // IANA zone. The dashboard renders in UTC (src/i18n/request.ts), so the UI
  // has to name this zone rather than imply the reader's local time.
  timeZone         String            @default("UTC")
  // The task text handed to the agent on each occurrence.
  input            String?
  isActive         Boolean           @default(true)
  // Always stamped from the scheduler's injected runtime.now(), never from the
  // database default — see the AgentRun comment below.
  nextRunAt        DateTime
  lastRunAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  runs AgentRun[]

  @@unique([id, workspaceId])
  @@index([workspaceId, agentId, nextRunAt])
  // Scheduler due-query; intentionally NOT workspace-prefixed (cross-tenant
  // sweep), exactly like Service.nextCheckAt.
  @@index([isActive, nextRunAt])
}

model AgentRun {
  id                  String         @id @default(cuid())
  workspaceId         String
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Live pointers go null when the agent or schedule is deleted; the source
  // ids and the snapshot below keep the history readable regardless.
  agentId             String?
  agentWorkspaceId    String?
  agent               Agent?         @relation(fields: [agentId, agentWorkspaceId], references: [id, workspaceId], onDelete: SetNull)
  sourceAgentId       String
  scheduleId          String?
  scheduleWorkspaceId String?
  schedule            AgentSchedule? @relation(fields: [scheduleId, scheduleWorkspaceId], references: [id, workspaceId], onDelete: SetNull)
  sourceScheduleId    String?

  // Immutable snapshot of the configuration this run executed under, so a run
  // stays reproducible and explainable after the agent is edited.
  snapshotAgentName      String
  snapshotInstructions   String
  snapshotScopes         String[] @default([])
  snapshotSkills         Json     @default("[]")
  snapshotMaxSteps       Int
  snapshotMaxTokens      Int
  snapshotTimeoutSeconds Int
  input                  String?

  // Claim queue, mirroring MailFilterRun. The idempotency key is what makes
  // schedule materialisation safe against two ticks racing.
  status            AgentRunStatus  @default(PENDING)
  trigger           AgentRunTrigger
  idempotencyKey    String          @unique
  attempts          Int             @default(0)
  maxAttempts       Int             @default(2)
  // The default exists only so a hand-written INSERT is valid; every code path
  // stamps this from the scheduler's runtime.now(). Claim queries filter on a
  // Node-supplied clock, and mixing the two produced a real bug once (fc111d5).
  nextAttemptAt     DateTime        @default(now())
  leaseToken        String?
  leaseExpiresAt    DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  deadlineAt        DateTime?
  cancelRequestedAt DateTime?

  // Outcome.
  stepCount        Int      @default(0)
  toolCallCount    Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  stopReason       String?
  summary          String?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  steps AgentRunStep[]

  @@unique([id, workspaceId])
  @@index([workspaceId, sourceAgentId, createdAt, id])
  @@index([workspaceId, status, createdAt, id])
  // Cross-tenant sweeps: claim, lease reclaim, retention prune.
  @@index([status, nextAttemptAt, createdAt, id])
  @@index([status, leaseExpiresAt, id])
  @@index([status, createdAt])
}

model AgentRunStep {
  id             String           @id @default(cuid())
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runId          String
  runWorkspaceId String
  run            AgentRun         @relation(fields: [runId, runWorkspaceId], references: [id, workspaceId], onDelete: Cascade)
  index          Int
  kind           AgentRunStepKind
  // TOOL_CALL only.
  toolName       String?
  toolScope      String?
  argsJson       Json?
  resultText     String?
  isError        Boolean          @default(false)
  // MODEL_CALL only.
  modelText      String?
  stopReason     String?

  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  durationMs       Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([runId, index])
  @@index([workspaceId, runId, index])
}
